<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  用户 Mapper。

  迁移口径（《迁移参照系》§2.1）：SQL 文本从 TV 的 UserDao 原样搬，只改参数记号。
  namespace 必须与 UserDao 全限定名一致。
-->
<mapper namespace="io.github.yjhhhaaa06.videoweb.user.dao.UserDao">

    <!--
      显式 resultMap 取代 TV 的手写 buildUserForLogin / buildUserForProfile。
      列名 → 属性名的 snake_case 映射在此显式声明，不依赖 map-underscore-to-camel-case
      的全局开关（显式优于隐式，且便于将来加字段时一眼看到）。
    -->
    <resultMap id="userResultMap" type="io.github.yjhhhaaa06.videoweb.user.model.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="hashedPassword" column="hashed_password"/>
        <result property="phone" column="phone"/>
        <result property="followerCount" column="follower_count"/>
        <result property="followCount" column="follow_count"/>
        <result property="role" column="role"/>
    </resultMap>

    <!-- TV: insert into users(username,hashed_password,phone) values(?,?,?) -->
    <insert id="insert" parameterType="io.github.yjhhhaaa06.videoweb.user.model.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        insert into users(username, hashed_password, phone)
        values(#{username}, #{hashedPassword}, #{phone})
    </insert>

    <!-- TV: select * from users where id=? -->
    <select id="findByIdForLogin" resultMap="userResultMap">
        select * from users where id = #{id}
    </select>

    <!-- TV: select * from users where phone=? -->
    <select id="findByPhoneForLogin" resultMap="userResultMap">
        select * from users where phone = #{phone}
    </select>

    <!--
      TV: getUserForProfileById 用的是 select *，但只装配 id/username/follower_count/follow_count。
      这里**收窄为显式列**：资料接口没有理由把 hashed_password 读出来，
      减少明文口令散列在内存/日志中的暴露面。
    -->
    <select id="findByIdForProfile" resultMap="userResultMap">
        select id, username, phone, follower_count, follow_count, role
        from users where id = #{id}
    </select>

    <!-- TV: select 1 from users where phone=? -->
    <select id="isPhoneUsed" resultType="boolean">
        select exists(select 1 from users where phone = #{phone})
    </select>

    <!-- TV: select 1 from users where username=? -->
    <select id="isUsernameUsed" resultType="boolean">
        select exists(select 1 from users where username = #{username})
    </select>

    <!-- TV: select role from users where id=? （查无此人返回 0） -->
    <select id="findRoleById" resultType="int">
        select coalesce((select role from users where id = #{id}), 0)
    </select>

    <!-- TV: update users set hashed_password=? where id=? -->
    <update id="updatePassword">
        update users set hashed_password = #{hashedPassword} where id = #{id}
    </update>

    <!-- TV: update users set username=? where id=? -->
    <update id="updateUsername">
        update users set username = #{username} where id = #{id}
    </update>

    <!-- ======================================================================
         S4（follow 切片）补搬的 7 条。
         ====================================================================== -->

    <!-- TV: updateFollowCount —— update users set follow_count = follow_count + ? where id=?
         ★ T34 补防负守卫（TV 原 SQL 无守卫）。users.follow_count 是 int unsigned ⇒
         守卫**不能**用 `follow_count + delta >= 0`（在 unsigned 列上自身下溢 1690），
         须 CAST(... AS SIGNED)。block 语义：拦住 ⇒ 影响 0 行、不抛错、不回滚。
         详见 UserDao#updateFollowCount 的 Javadoc。 -->
    <update id="updateFollowCount">
        update users set follow_count = follow_count + #{delta}
        where id = #{userId} and CAST(follow_count AS SIGNED) + #{delta} &gt;= 0
    </update>

    <!-- TV: updateFollowerCount —— update users set follower_count = follower_count + ? where id=?
         ★ 同上：T34 补防负守卫（users.follower_count 也是 int unsigned ⇒ CAST(... AS SIGNED)）。 -->
    <update id="updateFollowerCount">
        update users set follower_count = follower_count + #{delta}
        where id = #{userId} and CAST(follower_count AS SIGNED) + #{delta} &gt;= 0
    </update>

    <!-- TV: findUsersByIds —— SELECT id, username FROM users WHERE id IN (...) ORDER BY id
         StringBuilder 拼 IN → <foreach>（集合非空由调用方保证）。
         ★ ORDER BY id 是契约（分页顺序稳定性），勿删。只选两列 ⇒ 用同一 resultMap，其余属性为 null。 -->
    <select id="findUsersByIds" resultMap="userResultMap">
        SELECT id, username FROM users WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY id
    </select>

    <!-- TV: getFollowCountById —— select follow_count from users where id=?
         TV 在 Java 里用"无行 ⇒ 返回 0"表达"用户不存在按 0 处理"；
         此处 COALESCE 把该语义收进 SQL（与同文件 findRoleById 同款），避免无行 → null → 拆箱 NPE。 -->
    <select id="getFollowCountById" resultType="int">
        select coalesce((select follow_count from users where id = #{userId}), 0)
    </select>

    <!-- TV: getFollowerCountById —— select follower_count from users where id=?，口径同上。 -->
    <select id="getFollowerCountById" resultType="int">
        select coalesce((select follower_count from users where id = #{userId}), 0)
    </select>

    <!-- TV: insertAutoBigV —— insert ignore into auto_bigv(user_id) values(?)
         返回 boolean ⇒ MyBatis 的 affected > 0（单行 DML 等价于 TV 的 affected == 1）。
         ★ 这个返回值是 edge 信号，是语义的一部分（UPGRADED），不要改成 int 再自己比。 -->
    <insert id="insertAutoBigV">
        insert ignore into auto_bigv(user_id) values(#{userId})
    </insert>

    <!-- TV: deleteAutoBigV —— delete from auto_bigv where user_id=?
         返回 boolean ⇒ affected > 0（DOWNGRADED 的 edge 信号）。 -->
    <delete id="deleteAutoBigV">
        delete from auto_bigv where user_id = #{userId}
    </delete>

    <!-- TV: findAutoBigVUserIdsIn（S9 补入，读侧大V判定三路并集第②路）—— StringBuilder 拼 IN → <foreach>。
         SELECT user_id FROM auto_bigv WHERE user_id IN (?,…) —— PK(user_id) 覆盖索引点查，无新索引。 -->
    <select id="findAutoBigVUserIdsIn" resultType="java.lang.Long">
        SELECT user_id FROM auto_bigv WHERE user_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- TV: findUserIdsByMinFollowerCount（S9 补入，读侧大V判定三路并集第③路）—— 同上。
         SELECT id FROM users WHERE follower_count >= ? AND id IN (?,…)
         ★ 冷启动兜底：历史已达标但未入状态表的作者，不得因"没有状态行"被突然降级。 -->
    <select id="findUserIdsByMinFollowerCount" resultType="java.lang.Long">
        SELECT id FROM users WHERE follower_count >= #{minFollowerCount} AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <!-- ======================================================================
         投币专项 T37（硬币供给端）补入的 4 条。
         口径：architecture/domain/coin/coin.md §四 / §五.2。
         ★ coin_deci 全程是**十分位整数**（值 = 币 × 10），SQL 里不出现任何 ×10 / ÷10。
         ====================================================================== -->

    <!-- 余额增减（十分位）。T38 用：作者 +amount（amount 枚 × 1/10 == amount 个十分位）、
         投票者 −count × 10。⚠️ 本语句**没有**余额守卫：扣款必须另走
         `where coin_deci >= ?` 的条件写（设计 §五.1），不得先读后写。 -->
    <update id="updateCoinDeci">
        update users set coin_deci = coin_deci + #{deltaDeci}
        where id = #{userId}
    </update>

    <!-- 投币扣款（T38）：**带 >= 守卫的条件写** —— 这是"余额够不够"的唯一判据。
         影响 0 行 ⇒ 余额不足 ⇒ 400「硬币不足」。
         ★ 守卫不可省：去掉它，并发两次投币会把余额扣成负数（CoinAddTests 的余额/并发用例会红）。
         ★ 禁止改成"先查余额再 UPDATE"：读写窗口在并发下必然漏判。
         ★ 本语句是**唯一**一处带 >= 守卫的余额写；作者收益仍走上面的 updateCoinDeci。 -->
    <update id="deductCoinDeci">
        update users set coin_deci = coin_deci - #{costDeci}
        where id = #{userId} and coin_deci &gt;= #{costDeci}
    </update>

    <!-- 签到：一条原子条件 UPDATE（幂等 + 并发安全都靠它）。
         影响 1 行 = 本次到账；0 行 = 今日已签（或用户不存在）⇒ 200「今日已签到」。
         ★ 守卫括号**不可省**：`last_sign_date is null` 覆盖新用户，
           `last_sign_date &lt; #{today}` 覆盖"昨天/更早签过"。改成先查后写 ⇒ 并发双击 +20。
         ★ 加多少由 #{deciPerCoin} 传入（调用方传 CoinService.DECI_PER_COIN = 10），
           本文件**只在这一处**出现"一枚硬币"的量，避免魔法数散落。 -->
    <update id="signIn">
        update users
           set coin_deci = coin_deci + #{deciPerCoin},
               last_sign_date = #{today}
         where id = #{userId}
           and (last_sign_date is null or last_sign_date &lt; #{today})
    </update>

    <!-- 余额（单列，十分位）。返回包装类型 Integer：无行 ⇒ null（不是 0 —— 0 是真实余额）。
         与 getFollowCountById 的 COALESCE 口径**有意不同**，理由见 UserDao#findCoinDeci。 -->
    <select id="findCoinDeci" resultType="java.lang.Integer">
        select coin_deci from users where id = #{userId}
    </select>

    <!-- 最近签到日（单列，date）。无行 / 未签到 ⇒ null，两种 null 在签到判定上等价。 -->
    <select id="findLastSignDate" resultType="java.time.LocalDate">
        select last_sign_date from users where id = #{userId}
    </select>

    <!-- 记录浏览历史开关（R-25；V9 的列）。包装 Boolean：无行 ⇒ null ⇒ 调用方按"开"处理。
         ★ history 域**不读**这一列 —— 服务端不强制该开关（刻意，见 history-已知代价.md）。 -->
    <select id="findHistoryRecording" resultType="java.lang.Boolean">
        select history_recording from users where id = #{userId}
    </select>

    <!-- 写开关：单条 UPDATE ⇒ 天然幂等（同值重写结果一样），重试安全。 -->
    <update id="updateHistoryRecording">
        update users set history_recording = #{recording} where id = #{userId}
    </update>

</mapper>
