<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  content Mapper。

  历史：S2 只含 comment 写路径所需的 3 条（content-thin）；S5 补齐读路径 / 搜索 / 作者写路径。
  每条上方保留 TV 原 SQL 对照，便于逐字复核「SQL 未被改动」。
  namespace 必须与 ContentDao 全限定名一致。
-->
<mapper namespace="io.github.yjhhhaaa06.videoweb.content.dao.ContentDao">

    <!--
      内容行 → ContentCacheDTO（显式 resultMap；全局 map-underscore-to-camel-case 已关）。
      ⚠️ 列别名必须与三条查询（findContent / findContentsByIds / findAllContent）逐字一致：
         作者 id 一律取 `u.id AS user_id`，作者名一律取 `u.username`。
      ⚠️ 媒体字段（coverUrl/videoUrl/imageUrls）**不在此映射**——DB 查询不返回它们，
         由 ContentCache.buildContentMedia 从 content_media 补齐（三处共用同一装载路径）。
    -->
    <resultMap id="contentCacheMap" type="io.github.yjhhhaaa06.videoweb.content.model.cache.ContentCacheDTO">
        <id property="id" column="id"/>
        <result property="authorId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="categoryId" column="category_id"/>
        <result property="commentEnabled" column="comment_enabled"/>
        <result property="authorName" column="username"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- TV: SELECT COUNT(*) FROM content WHERE id = ? AND is_deleted = 0
         ★ is_deleted = 0 是有意的：给已删除内容评论必须被拒。
         写法：COUNT(*) > 0 → EXISTS（行集等价；与 UserDao.isPhoneUsed 同款）。 -->
    <select id="isContentExist" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM content WHERE id = #{contentId} AND is_deleted = 0)
    </select>

    <!-- 读未软删内容的类型（收藏三期 T17：稍后再看"只能加视频"的门禁）。
         ★ 与 isContentExist 同一形态，只是带回 type —— 一趟覆盖 add/move 的 404（无行）与
           400（非视频）两条拒因。
         ⚠️ 返回 Integer（包装）：无行 / 已软删 ⇒ null；声明成 int 会在无行时 NPE（同 getContentStatus）。
         ⚠️ 口径 = content.type（1 视频 / 2 图文；媒体表的 3 封面与这里无关）。 -->
    <select id="findAliveContentType" resultType="java.lang.Integer">
        SELECT type FROM content WHERE id = #{contentId} AND is_deleted = 0
    </select>

    <!-- 投币 T38：一趟取回（作者 id，类型）—— 404 / 400（图文）/ 400（自投）三条判据的输入。
         ★ 与 findAliveContentType 同一形态，只是多选一列 user_id（主键点查，列随行取到）。
         ⚠️ ContentAuthorAndType 是 record ⇒ **必须用 <constructor>**（默认对象工厂走 setter ⇒
            "no setter for property"）；javaType 必须是包装类型 Long / Integer（实测口径同 AuthorContentId）。 -->
    <resultMap id="contentAuthorAndTypeMap"
               type="io.github.yjhhhaaa06.videoweb.content.model.ContentAuthorAndType">
        <constructor>
            <arg column="author_id" javaType="java.lang.Long"/>
            <arg column="type" javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <select id="findAliveContentAuthorAndType" resultMap="contentAuthorAndTypeMap">
        SELECT user_id AS author_id, type FROM content WHERE id = #{contentId} AND is_deleted = 0
    </select>

    <!-- 投币数累加（T38）。★ **刻意没有防负守卫**：投币不可取消 ⇒ coin_count 只增，
         不存在下溢场景（与 comment_count / like_count 的 CAST 守卫是**口径差异、不是漏改**，
         见 architecture/domain/coin/coin.md §十 #3）。
         必须与 content_coin 的关系行同事务（投币 Service 的 @Transactional）。 -->
    <update id="updateCoinCount">
        UPDATE content SET coin_count = coin_count + #{delta} WHERE id = #{contentId}
    </update>

    <!-- 投币计数单列窄查询（T39 缓存 miss 的回源）。
         ★ **刻意不加 is_deleted 过滤**：读的是列值（缓存要复现"这一列现在是多少"），
           不是"内容是否可见"；可见性判定在详情读路径（findContent）。
         ⚠️ 返回 Integer（包装）：无行 ⇒ null ⇒ 缓存层不写缓存（避免把"内容不存在"钉成 0）。 -->
    <select id="findCoinCount" resultType="java.lang.Integer">
        select coin_count from content where id = #{contentId}
    </select>

    <!-- 评论总数单列窄查询（T43 计数缓存 miss 的回源）。
         ★ 同样**刻意不加 is_deleted 过滤**（理由同 findCoinCount）：读的是列值。
         ⚠️ 返回 Integer（包装）：无行 ⇒ null ⇒ 缓存层不写缓存。 -->
    <select id="findCommentCount" resultType="java.lang.Integer">
        select comment_count from content where id = #{contentId}
    </select>

    <!-- 点赞总数单列窄查询（T44-1：LikeCache 计数回源从 COUNT(*) content_like 切到本列）。
         ★ 列自 V1 起存在、由点赞写路径事务内 ±1 维护（updateLikeCount），只是此前读路径从未消费。
         同样**刻意不加 is_deleted 过滤**（理由同 findCoinCount）：读的是列值；
         配套不变式 = 作者删除内容时 deleteContent 同事务把本列归零（见 resetLikeCount）
         ⇒ like_count == COUNT(*) content_like 对所有行成立。
         ⚠️ 返回 Integer（包装）：无行 ⇒ null ⇒ 缓存层不写缓存。 -->
    <select id="findLikeCountById" resultType="java.lang.Integer">
        select like_count from content where id = #{contentId}
    </select>

    <!-- 一趟读齐四公共计数列（T44-2 详情计数聚合读的回源）。
         ★ 四列同在本行 ⇒ 一趟主键点查（冷内容全 miss 从 5 条 SQL 收敛为 1 条）。
         同样**刻意不加 is_deleted 过滤**（理由同 findCoinCount）：读的是列值；
         调用时序保证载荷已命中 ⇒ 必有行，无行 null 是防御分支。
         ⚠️ ContentCountColumns 是 record ⇒ 必须 <constructor>，javaType 包装类型。 -->
    <resultMap id="contentCountColumnsMap"
               type="io.github.yjhhhaaa06.videoweb.content.model.ContentCountColumns">
        <constructor>
            <arg column="like_count" javaType="java.lang.Long"/>
            <arg column="comment_count" javaType="java.lang.Long"/>
            <arg column="favorite_count" javaType="java.lang.Long"/>
            <arg column="coin_count" javaType="java.lang.Long"/>
            <arg column="play_count" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <select id="findCountColumns" resultMap="contentCountColumnsMap">
        select like_count, comment_count, favorite_count, coin_count, play_count
        from content where id = #{contentId}
    </select>

    <!-- T39 批量回填：一趟 IN 取多条（ContentCoinCount 是 record ⇒ 必须 <constructor>；
         javaType 必须是包装类型 Long / Integer，构造器按 Class 匹配）。
         同样不带走 is_deleted 过滤（理由同 findCoinCount）。 -->
    <resultMap id="contentCoinCountMap"
               type="io.github.yjhhhaaa06.videoweb.content.model.ContentCoinCount">
        <constructor>
            <arg column="content_id" javaType="java.lang.Long"/>
            <arg column="coin_count" javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <select id="findCoinCountsByIds" resultMap="contentCoinCountMap">
        select id as content_id, coin_count from content where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- TV: UPDATE content SET comment_count = comment_count + ? WHERE id = ?
         ★ T34 补防负守卫（TV 原 SQL 无守卫）。⚠️ content.comment_count 是 int unsigned，
         守卫**不能**照抄 comment.updateReplyCount 的 `col + delta >= 0`——在 unsigned 列上
         `0 + (-1)` 会先触发 1690 下溢（守卫自身也炸；见 ContentDao#updateCommentCount 的 Javadoc 实测）。
         故守卫用 CAST(… AS SIGNED) 把比较挪到有符号空间；SET 里的 `col + delta` 只在守卫通过
         （结果 ≥ 0）时执行，故不会下溢。block 语义：守卫拦住 ⇒ 影响 0 行、不抛错、不触发回滚。 -->
    <update id="updateCommentCount">
        UPDATE content SET comment_count = comment_count + #{delta}
        WHERE id = #{contentId} AND CAST(comment_count AS SIGNED) + #{delta} &gt;= 0
    </update>

    <!-- TV: ContentCache 内部 loadContentFromDb 的 comment_enabled 列
         直读 DB 而非缓存（有意改进，见 ContentDao#findCommentEnabledById 的 Javadoc）。
         单列查询：无行 ⇒ MyBatis 返回 null；有行 ⇒ tinyint(1) → Boolean。 -->
    <select id="findCommentEnabledById" resultType="java.lang.Boolean">
        SELECT comment_enabled FROM content WHERE id = #{contentId} AND is_deleted = 0
    </select>

    <!-- TV: UPDATE content SET like_count = like_count + ? WHERE id = ?
         ★ T34 补防负守卫（形式与理由同上面的 updateCommentCount：unsigned 列 ⇒ 必须 CAST(... AS SIGNED)，
         否则守卫自身下溢）。content.like_count 是 int unsigned，与 comment.like_count 的有符号 int
         形成不对称——两处 T34 都加了守卫，但 unsigned 侧靠 CAST、signed 侧靠原生比较（见各自 Javadoc）。
         本方法由 S3 补上（S1 的 content-thin 曾有意排除它）。 -->
    <update id="updateLikeCount">
        UPDATE content SET like_count = like_count + #{delta}
        WHERE id = #{contentId} AND CAST(like_count AS SIGNED) + #{delta} &gt;= 0
    </update>

    <!-- 作者删除内容时把 like_count 归零（T44-1）：物理删 content_like 行的同一事务里调用。
         ★ 写绝对值 0 而非 ±delta：删除时不知道现值，置 0 恒安全（无 unsigned 下溢）；
         不归零则 like_count == COUNT(*) 不变量对软删行破裂（T44-1 起回源读列，
         /like/content/count 对已删内容会回退成旧值而非 0）。 -->
    <update id="resetLikeCount">
        UPDATE content SET like_count = 0 WHERE id = #{contentId}
    </update>

    <!-- 播放量 +1（T47，history 写路径的唯一计数入口）：`/history/play` 判首播成功后，
         与 watch_history 的标记位**同一事务**执行。
         ★ 无防负守卫：play_count 是 int unsigned 且**只增**（没有"取消播放"）
           ⇒ 不需要 like_count / comment_count 那套 CAST(... AS SIGNED)（口径差异，非漏改，
           见 history.md §二）。
         ★ 内容删除后本语句**不会被调用**（/play 先过 404），历史行也不动
           —— 失效占位要它（history.md §五）。 -->
    <update id="updatePlayCount">
        UPDATE content SET play_count = play_count + 1 WHERE id = #{contentId}
    </update>

    <!-- 收藏数批量重算（T12，与 like_count 增量式**刻意不同**）：一趟 CASE-WHEN 写回一批行的
         favorite_count 绝对值，**不是** N 次单行 UPDATE（删夹可一次波及上千条内容，
         逐行 UPDATE 就是 N 次往返 —— favorite.md §四 强制探索的确认点）。
         ★ 为什么写"绝对值"而不是 like_count 那样的 ±delta：收藏数按人去重
           （COUNT(DISTINCT user_id)），而 favorite_item 的唯一键是 uk_folder_content（夹内唯一）
           —— 同一人可把同一内容收进多夹 ⇒ add/remove 不必然 ±1、并发下判"第一次收藏"必然漏。
           增量会漂移且永不自愈；重算是幂等复算，第二处事实源只在事务内被维护
           （口径与排除理由见 favorite.md §四）。
         ★ 入参每个 (contentId, favoriteCount) 对都来自**同一事务内**刚算出的聚合
           （FavoriteService.recountFavoriteCounts）⇒ 本语句必须运行在调用方事务里
           （与关系行的增删同进同退，否则计数与明细在提交窗口内不一致）。
         ⚠️ 聚合不出的 id（收藏清空 / 从未有人收藏）由调用方补 0 后也在 IN 列表里
           —— "清零"同样要落列，不变量对 0 成立。
         ⚠️ 幽灵 id（content 行不存在）在 WHERE id IN 里匹配 0 行，自然无害。
         ⚠️ 空列表会生成 CASE ... END 空体 / IN () 语法错 —— service 已拦空集（删空夹是合法路径）。 -->
    <update id="updateFavoriteCounts">
        UPDATE content
        SET favorite_count = CASE id
        <foreach collection="favoriteCounts" item="row">
            WHEN #{row.contentId} THEN #{row.favoriteCount}
        </foreach>
        END
        WHERE id IN
        <foreach collection="favoriteCounts" item="row" open="(" separator="," close=")">
            #{row.contentId}
        </foreach>
    </update>

    <!-- 收藏数列读（T12：/favorite/count 缓存 miss 的回源，唯一调用点
         FavoriteCache#loadFavoriteCount）。一期回源是实时 COUNT(DISTINCT user_id) 聚合
         （≈17ms / 2 万行基线，favorite.md §四）；T12 起列由收藏域四条写路径的
         「事务内批量重算」（上面的 updateFavoriteCounts）维护 ⇒ 回源降为点查。
         ★ 不变量 favorite_count == COUNT(DISTINCT user_id) 由 T12 的独立 oracle 用例钉住
           —— 本查询的正确性完全建立在那个不变量上。
         ★ 写成 COALESCE((SELECT ...), 0) **保证恒有一行**：裸 SELECT 在内容行不存在时
           MyBatis 返回 null，映射原始 long 会 NPE（ContentDao#getContentStatus 注释的实测口径）；
           且"无行 ⇒ 0"与一期 COUNT 的可观察语义一致（不给内容存在性开探测口）。 -->
    <select id="findFavoriteCountById" resultType="long">
        SELECT COALESCE(
                   (SELECT favorite_count FROM content WHERE id = #{contentId}),
                   0)
    </select>

    <!-- ============================ S5：读路径 ============================ -->

    <!-- TV: ContentDao.findContent —— 列顺序、`u.id AS user_id` 别名、`WHERE c.id=? AND is_deleted =0`
         全部原样（别名不得改动：批量装载按 id 归位、作者 id 映射都依赖它）。 -->
    <select id="findContent" resultMap="contentCacheMap">
        SELECT
           c.id,
           c.title,
           c.description,
           c.type,
           c.category_id,
           c.comment_enabled,
           c.create_time,
           u.username,
           u.id AS user_id
       FROM content c
       JOIN users u ON c.user_id = u.id
       WHERE c.id=#{contentId} AND is_deleted =0
    </select>

    <!-- TV: findContentsByIds —— `StringBuilder` 拼 `IN (?,?,…)` 改 <foreach>（机械改动，SQL 语义不变）。
         空集合由 DAO 的入参断言挡住（本仓写法：MyBatis 侧不处理空 IN）。 -->
    <select id="findContentsByIds" resultMap="contentCacheMap">
        SELECT
           c.id,
           c.title,
           c.description,
           c.type,
           c.category_id,
           c.comment_enabled,
           c.create_time,
           u.username,
           u.id AS user_id
       FROM content c
       JOIN users u ON c.user_id = u.id
       WHERE c.is_deleted = 0 AND c.id IN
       <foreach item="id" collection="ids" open="(" separator="," close=")">
           #{id}
       </foreach>
    </select>

    <!-- TV: findAllContent —— 索引懒重建的装载源。`ORDER BY c.create_time DESC, c.id DESC` 原样。 -->
    <select id="findAllContent" resultMap="contentCacheMap">
        SELECT
           c.id,
           c.title,
           c.description,
           c.type,
           c.category_id,
           c.comment_enabled,
           c.create_time,
           u.username,
           u.id AS user_id
       FROM content c
       JOIN users u ON c.user_id = u.id
       WHERE is_deleted =0
       ORDER BY c.create_time DESC, c.id DESC
    </select>

    <!--
      TV: keywordSearchInBrief —— 两条分支**逐字保留**（含两处 ORDER BY 的 `, c.id DESC`
      tie-breaker，T15 修复；缺它同秒内容分页会重复/漏项）。
      判据 = trim 后关键词长度（Service 已 trim）。
      TV 的 `pstmt.setString(1, "%" + kw + "%")` 等价写作 `CONCAT('%', #{keyword}, '%')`。
    -->
    <select id="keywordSearchInBrief" resultType="java.lang.Long">
        <choose>
            <when test="keyword != null and keyword.length() == 1">
                SELECT c.id FROM content c
                WHERE c.title LIKE CONCAT('%', #{keyword}, '%') AND c.is_deleted = 0
                ORDER BY c.create_time DESC, c.id DESC
                LIMIT #{offset}, #{limit}
            </when>
            <otherwise>
                SELECT c.id FROM content c
                WHERE MATCH(c.title, c.description) AGAINST (#{keyword} IN NATURAL LANGUAGE MODE)
                  AND c.is_deleted = 0
                ORDER BY c.create_time DESC, c.id DESC
                LIMIT #{offset}, #{limit}
            </otherwise>
        </choose>
    </select>

    <!-- TV: countKeywordSearch —— 分支判据与 list 查询**同源**（否则 total 与 list 口径漂移）。 -->
    <select id="countKeywordSearch" resultType="int">
        <choose>
            <when test="keyword != null and keyword.length() == 1">
                SELECT COUNT(*) FROM content c
                WHERE c.title LIKE CONCAT('%', #{keyword}, '%') AND c.is_deleted = 0
            </when>
            <otherwise>
                SELECT COUNT(*) FROM content c
                WHERE MATCH(c.title, c.description) AGAINST (#{keyword} IN NATURAL LANGUAGE MODE)
                  AND c.is_deleted = 0
            </otherwise>
        </choose>
    </select>

    <!-- TV: countContentByUser -->
    <select id="countContentByUser" resultType="int">
        SELECT COUNT(*) FROM content WHERE user_id = #{userId} AND is_deleted = 0
    </select>

    <!-- TV: findContentIdsByUserWindow —— `ORDER BY c.id DESC LIMIT ? OFFSET ?`
         用 id 而非 create_time 排序的理由（TV 原注释）：idx_user_id 物理为 (user_id, id)，
         反向索引扫描免 filesort，成本 ∝ offset+pageSize。**不得改回 create_time**。 -->
    <select id="findContentIdsByUserWindow" resultType="java.lang.Long">
        SELECT c.id FROM content c WHERE c.user_id = #{userId} AND c.is_deleted = 0
        ORDER BY c.id DESC LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- TV: findContentIdsByUser —— 全量（改名级联失效用）。
         ⚠️ 与窗口版**并存**：分页用窗口版，失效用全量版。 -->
    <select id="findContentIdsByUser" resultType="java.lang.Long">
        SELECT c.id FROM content c WHERE c.user_id = #{userId} AND c.is_deleted = 0
        ORDER BY c.create_time DESC, c.id DESC
    </select>

    <!-- ============================ S5：作者写路径 ============================ -->

    <!-- TV: updateCommentEnabled —— `ps.setInt(1, enabled ? 1 : 0)` 的等价值：boolean → tinyint 隐式转换。 -->
    <update id="updateCommentEnabled">
        UPDATE content SET comment_enabled = #{enabled} WHERE id = #{contentId}
    </update>

    <!-- TV: updateContentInfo（A3）。全文索引由 MySQL 自动维护，无额外语句。 -->
    <update id="updateContentInfo">
        UPDATE content SET title = #{title}, description = #{description} WHERE id = #{contentId}
    </update>

    <!-- TV: softDeleteContent（A1，复用 is_deleted 字段，无 DDL）。 -->
    <update id="softDeleteContent">
        UPDATE content SET is_deleted = 1 WHERE id = #{contentId}
    </update>

    <!-- ============================ S7：upload 发布写路径 ============================ -->

    <!-- TV: addContent —— `insert into content (user_id, title,type, description,category_id)
         values (?, ?, ?,?,?)`（列顺序与写法逐字保留）。
         `Statement.RETURN_GENERATED_KEYS + getGeneratedKeys()` 骨架 → useGeneratedKeys 回填 id。
         其余列走表默认值（TV 原样）。 -->
    <insert id="addContent" parameterType="io.github.yjhhhaaa06.videoweb.content.model.entity.Content"
            useGeneratedKeys="true" keyProperty="id">
        insert into content (user_id, title,type, description,category_id)
        values (#{userId}, #{title}, #{type}, #{description}, #{categoryId})
    </insert>

    <!-- TV: updateFileExists —— `update content set file_exists=?, last_verify_time=? where id=?`
         （换源后回写内容级文件完整性聚合；boolean → tinyint 隐式转换）。 -->
    <update id="updateFileExists">
        update content set file_exists=#{exists}, last_verify_time=#{lastVerifyTime} where id=#{contentId}
    </update>

    <!-- ============================ S8：admin（内容运维） ============================ -->

    <!-- TV: SELECT is_deleted FROM content WHERE id = ?
         ★ 原样不带 `is_deleted = 0` 过滤——前置校验就是要看它当前是几（0 正常 / 1 作者删 / 2 下架）。
         ⚠️ 与 TV 的**唯一差异**：TV 用 rs.next() 落 -1 作"不存在"哨兵；此处让 MyBatis 在无行时
            返回 null（resultType 用包装类型 Integer），由 Service 判 null → 404。语义等价，
            且免掉一个魔法值（见 ContentService.checkContentState 的说明）。 -->
    <select id="getContentStatus" resultType="java.lang.Integer">
        SELECT is_deleted FROM content WHERE id = #{contentId}
    </select>

    <!-- TV: UPDATE content SET is_deleted = ? WHERE id = ?
         只改状态，不动评论/点赞/媒体记录与物理文件（"隐藏≠删除"）。 -->
    <update id="updateContentDeletedState">
        UPDATE content SET is_deleted = #{state} WHERE id = #{contentId}
    </update>

    <!--
      TV: findContentForAdmin —— SQL 逐字保留（含 `is_deleted IN (0,2)` 与排序）：
        SELECT c.id, c.title, c.type, c.is_deleted, u.username AS author_name
        FROM content c JOIN users u ON c.user_id = u.id
        WHERE c.is_deleted IN (0, 2)
        ORDER BY c.create_time DESC, c.id DESC
      ⚠️ hidden 的映射：TV 在 Java 侧算 `rs.getInt("is_deleted") == 2`。
         这里让 is_deleted 直接映射成 boolean（BooleanTypeHandler → 数值列取 != 0）；
         因查询已限定 IN (0,2)，`!= 0` 与 `== 2` **等价**。
    -->
    <resultMap id="adminContentMap" type="io.github.yjhhhaaa06.videoweb.content.model.vo.AdminContentVO">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="type" column="type"/>
        <result property="authorName" column="author_name"/>
        <result property="hidden" column="is_deleted"/>
    </resultMap>

    <select id="findContentForAdmin" resultMap="adminContentMap">
        SELECT c.id, c.title, c.type, c.is_deleted, u.username AS author_name
        FROM content c
        JOIN users u ON c.user_id = u.id
        WHERE c.is_deleted IN (0, 2)
        ORDER BY c.create_time DESC, c.id DESC
    </select>

    <!-- ============================ S9：feed（关注动态流） ============================ -->

    <!-- TV: findContentIdsByUsers —— 纯拉降级路径的当页 id
         SELECT c.id FROM content c WHERE c.user_id IN (?,…) AND c.is_deleted = 0
         ORDER BY c.create_time DESC, c.id DESC LIMIT ?, ?
         ⚠️ 两个排序键都在（create_time DESC 后跟 id DESC 的 tie-breaker），不得删。
         StringBuilder 拼 IN → <foreach>（SQL 文本其余部分逐字保留）。 -->
    <select id="findContentIdsByUsers" resultType="java.lang.Long">
        SELECT c.id FROM content c WHERE c.user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND c.is_deleted = 0
        ORDER BY c.create_time DESC, c.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- TV: countContentByUsers —— SELECT COUNT(*) FROM content WHERE user_id IN (?,…) AND is_deleted = 0
         与 findContentIdsByUsers 分支判据同源（否则 total 与 list 口径漂移）。 -->
    <select id="countContentByUsers" resultType="int">
        SELECT COUNT(*) FROM content WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND is_deleted = 0
    </select>

    <!-- TV: findRecentContentIdsByUsers —— 每作者各取最近 K 条，UNION ALL 成一条语句
         每分支： (SELECT id FROM content WHERE user_id = ? AND is_deleted = 0 ORDER BY id DESC LIMIT ?)
         ⚠️ 排序口径 = contentId 降序（id 自增 ⇒ 越大越新；与 feed_inbox 不存时间字段的口径同源）。
         ⚠️ is_deleted 不在 idx_user_id 中、需回表过滤 ⇒ 每分支最坏上界 = 该作者内容量（TV 原样登记）。 -->
    <select id="findRecentContentIdsByUsers" resultType="java.lang.Long">
        <foreach collection="userIds" item="userId" separator=" UNION ALL ">
            (SELECT id FROM content WHERE user_id = #{userId} AND is_deleted = 0
             ORDER BY id DESC LIMIT #{perAuthorLimit})
        </foreach>
    </select>

    <!-- TV: findRecentContentIdsByAuthor —— 同 findRecentContentIdsByUsers，但多选一列 user_id AS author_id
         （idx_user_id 物理为 (user_id, id)，该列随索引即可取到）⇒ 一趟查询即可按作者切分结果。
         ⚠️ UNION ALL 外层顺序不保证 ⇒ 调用方对每个作者显式降序重排。
         ⚠️ is_deleted 需回表过滤 ⇒ 每分支最坏上界 = 该作者内容量（TV 原样登记）。 -->
    <!-- ⚠️ AuthorContentId 是 record（不可变）⇒ **必须用 <constructor> 映射**：
         MyBatis 默认对象工厂走"无参构造 + setter"，对 record 会报
         "There is no setter for property named 'authorId'"（实测）。
         且 javaType 必须是**包装类型** java.lang.Long——构造器按 Class 匹配，
         原始类型 long 与 Long 不等 ⇒ "NoSuchMethodException: <init>(Long,Long)"（实测）。 -->
    <resultMap id="authorContentIdMap" type="io.github.yjhhhaaa06.videoweb.content.model.AuthorContentId">
        <constructor>
            <arg column="author_id" javaType="java.lang.Long"/>
            <arg column="id" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <select id="findRecentContentIdsByAuthor" resultMap="authorContentIdMap">
        <foreach collection="authorIds" item="authorId" separator=" UNION ALL ">
            (SELECT user_id AS author_id, id FROM content WHERE user_id = #{authorId} AND is_deleted = 0
             ORDER BY id DESC LIMIT #{perAuthorLimit})
        </foreach>
    </select>

</mapper>
