<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  watch_history Mapper（播放记录专项 T47；R-26 起本表**只存进度**，"计过数"搬去 content_play_dedup）。
  SQL 逐字来自 architecture/domain/history/history.md §四 —— 那几条语句是设计的一部分，
  尤其"ODKU 不判首播 / 首播靠账本的 INSERT IGNORE"的拆分，改动前先读那份文档。
-->
<mapper namespace="io.github.yjhhhaaa06.videoweb.history.dao.WatchHistoryDao">

    <!-- /history/report：一条 ODKU，**不判首播**（不读 play_counted、不看 affected rows）。
         ★ update_time 必须显式 SET：列上的 ON UPDATE 在"值没变"时不触发
           ⇒ 同一秒重复上报不会把该行移到列表最前（history.md §二 口径 5）。 -->
    <insert id="upsertProgress">
        INSERT INTO watch_history (user_id, content_id, progress_seconds)
        VALUES (#{userId}, #{contentId}, #{progressSeconds})
        ON DUPLICATE KEY UPDATE
          progress_seconds = VALUES(progress_seconds),
          update_time = CURRENT_TIMESTAMP
    </insert>

    <!-- 批量落库（T51-2）：语义与 upsertProgress 逐字一致（LWW、只改进度与时间）。
         ★ update_time 取**每条自己的** serverReceiveTs（#{it.updateTime}），不能用 CURRENT_TIMESTAMP：
           一批里各条的接收时刻不同，用数据库当前时间会把它们压成同一秒 ⇒ 历史列表倒序退化。
         ★ 本表自 R-26 起**没有** play_counted 列（去重账本独立成表）。
         ⚠️ 一条语句 = 一个隐式事务：任一行失败整批回滚 ⇒ 调用方必须能降级逐条重试。 -->
    <insert id="upsertProgressBatch">
        INSERT INTO watch_history (user_id, content_id, progress_seconds, update_time)
        VALUES
        <foreach collection="items" item="it" separator=",">
            (#{userId}, #{it.contentId}, #{it.progressSeconds}, #{it.updateTime})
        </foreach>
        ON DUPLICATE KEY UPDATE
          progress_seconds = VALUES(progress_seconds),
          update_time = VALUES(update_time)
    </insert>

    <!-- /history/play：**只建行**（progress=0），不判首播。
         ★ R-26 起首播判据搬去 content_play_dedup（日期进主键），本语句只负责
           "只 play 不 report 的视频也要出现在历史里"。
         ★ 必须**无条件**执行（不能只在首播时执行）：用户删了历史又重看时，
           今天不会再计播放量，但历史行应该重新出现。 -->
    <insert id="insertIgnoreEmpty">
        INSERT IGNORE INTO watch_history (user_id, content_id, progress_seconds)
        VALUES (#{userId}, #{contentId}, 0)
    </insert>

    <!-- /history 删除（R-26）：作用域 = 当前登录用户（user_id 在 WHERE 里 ⇒ 天然无越权面）。
         ★ 命中 0 行不是错误（幂等 204）；不碰 content.play_count、也不碰 content_play_dedup ——
           删历史不减播放量，而"今天计过数"的证据在账本里、删行删不到它。
         空 IN 是 SQL 语法错 ⇒ 调用方必须保证非空（Service 已校验）。 -->
    <delete id="deleteByUserIdAndContentIds">
        DELETE FROM watch_history
        WHERE user_id = #{userId}
          AND content_id IN
        <foreach collection="contentIds" item="cid" open="(" separator="," close=")">
            #{cid}
        </foreach>
    </delete>

    <!-- /history 清空（R-26）：all=true 的落点。同上：幂等、不动播放量、不动账本。
         user_id 是 uk_user_content 的前缀 ⇒ 走唯一键范围扫描，不需要额外索引。 -->
    <delete id="deleteAllByUserId">
        DELETE FROM watch_history WHERE user_id = #{userId}
    </delete>

    <!-- /history/list 的行类型：★ 只映射本域三列。
         title/coverUrl/authorName/durationSeconds 由 HistoryService#list 经
         ContentService#loadContentVOs 组装；判失效也在那里（history.md §三 / §七.1）。
         ★ watchedTime = update_time（最后上报时间），**不是** create_time（首次观看）。 -->
    <resultMap id="historyItemVoMap"
               type="io.github.yjhhhaaa06.videoweb.history.model.vo.HistoryItemVO">
        <result property="contentId" column="content_id"/>
        <result property="watchedTime" column="update_time"/>
        <result property="progress" column="progress_seconds"/>
    </resultMap>

    <!-- 历史总条数（列表 total）。数的是 watch_history **行** —— 失效条目照常计入
         （内容删除不删历史行、占位不缩水；否则 total 与页内条数打架，history.md §七.1）。
         ★ 用户主动删除（R-26）之后不再计入 —— 那是"用户要它消失"，与"内容失效"是两回事。 -->
    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM watch_history WHERE user_id = #{userId}
    </select>

    <!-- 一页历史（update_time DESC, content_id DESC），走 idx_user_update_content（V8 的覆盖复合索引：
         前三列就是本 ORDER BY，progress_seconds 让本 SELECT 三列免回表）。
         ① ★ 不 join content / content_media / users（模块边界 §三；一期 I-07 的教训）：
            展示字段与失效判据都归 ContentService#loadContentVOs；
         ② ★ tie-breaker 用 content_id DESC（不是行 id）：update_time 是秒精度，
            同一秒的两行必须有序（history.md §三）；
         ③ 失效行**不跳过**：整页失效也照常返回（跳过 ⇒ 用户看不到 ⇒ 永远没人处理）。 -->
    <select id="findPageByUserId" resultMap="historyItemVoMap">
        SELECT content_id AS content_id,
               update_time AS update_time,
               progress_seconds AS progress_seconds
        FROM watch_history
        WHERE user_id = #{userId}
        ORDER BY update_time DESC, content_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 续播位置（/history/position）：uk_user_content 点查。
         ★ 刻意**不碰 content / content_media**、不判内容存在性（history.md §七.2）：
           内容已删照样回答进度（内容是死是活由详情 404 负责）。
         无行时 MyBatis 返回 null ⇒ service 折成 0（resultType 用包装 Integer，不用 int）。 -->
    <select id="findProgress" resultType="java.lang.Integer">
        SELECT progress_seconds FROM watch_history
        WHERE user_id = #{userId} AND content_id = #{contentId}
    </select>

</mapper>
