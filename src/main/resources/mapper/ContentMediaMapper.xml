<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  content_media Mapper（S5）。
  TV 的 ContentMediaDao 用 buildContentMedia(ResultSet) 手工装配；此处显式 resultMap。
  列顺序与别名逐字照搬 TV（`id` 映射到 mediaId——TV 的实体字段就叫 mediaId）。
-->
<mapper namespace="io.github.yjhhhaaa06.videoweb.content.dao.ContentMediaDao">

    <resultMap id="contentMediaMap" type="io.github.yjhhhaaa06.videoweb.content.model.entity.ContentMedia">
        <id property="mediaId" column="id"/>
        <result property="contentId" column="content_id"/>
        <result property="url" column="url"/>
        <result property="type" column="type"/>
        <result property="sort" column="sort"/>
    </resultMap>

    <!-- TV: select id,content_id,url,type,sort from content_media where content_id=? order by type,sort -->
    <select id="findMediaByContentId" resultMap="contentMediaMap">
        select id,content_id,url,type,sort from content_media where content_id=#{contentId}
        order by type,sort
    </select>

    <!-- TV: `... where content_id IN (?…) order by content_id,type,sort`
         —— StringBuilder 拼 IN 改 <foreach>（机械改动，SQL 语义不变）。 -->
    <select id="findMediaByContentIds" resultMap="contentMediaMap">
        select id,content_id,url,type,sort from content_media where content_id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by content_id,type,sort
    </select>

    <!-- TV: select id,content_id,url,type,sort from content_media where content_id=? and type=? and sort=? -->
    <select id="findMediaByContentTypeSort" resultMap="contentMediaMap">
        select id,content_id,url,type,sort from content_media
        where content_id=#{contentId} and type=#{type} and sort=#{sort}
    </select>

    <!-- TV: delete from content_media where content_id=? and type=? and sort=? -->
    <delete id="deleteMediaByContentIdAndTypeSort">
        delete from content_media where content_id=#{contentId} and type=#{type} and sort=#{sort}
    </delete>

    <!-- TV: update content_media set sort=sort-1 where content_id=? and type=2 and sort>?
         ★ type=2 写死在 SQL 里（只重排图片），与"作者只能删图片"的入口约束一致，一字未改。 -->
    <update id="compactImageSort">
        update content_media set sort=sort-1 where content_id=#{contentId} and type=2 and sort&gt;#{deletedSort}
    </update>

    <!-- TV: delete from content_media where content_id=? -->
    <delete id="deleteByContentId">
        delete from content_media where content_id=#{contentId}
    </delete>

    <!-- ============================ S7：upload 发布写路径 ============================ -->

    <!-- TV: addMedia —— `insert into content_media(content_id,url,type,sort) VALUES (?, ?,?,?)`
         （写法逐字保留；无生成键需求——媒体行 id 无人引用）。
         type 语义：1 视频 / 2 图片 / 3 封面（由调用方按上传类型给出）。 -->
    <insert id="addMedia">
        insert into content_media(content_id,url,type,sort) VALUES (#{contentId}, #{url}, #{type}, #{sort})
    </insert>

    <!-- TV: updateMediaUrl —— `update content_media set url=?, file_exists=?, last_verify_time=? where id=?`
         （换源：更新 url + 立即标记"文件存在" + 记录校验时间；boolean → tinyint 隐式转换）。 -->
    <update id="updateMediaUrl">
        update content_media set url=#{url}, file_exists=#{exists}, last_verify_time=#{lastVerifyTime}
        where id=#{mediaId}
    </update>

    <!-- ============================ S8：admin（媒体审计） ============================ -->

    <!-- TV: findAllMedia —— `select id,content_id,url,type,sort from content_media order by id`
         （运维全量扫描的装载源；无上限，仅管理员手工动作触发）。 -->
    <select id="findAllMedia" resultMap="contentMediaMap">
        select id,content_id,url,type,sort from content_media order by id
    </select>

    <!-- TV: findMediaById —— `select id,content_id,url,type,sort from content_media where id=?`
         （恢复前置：据 url 反解磁盘路径）。无行 → MyBatis 返回 null ⇒ 调用方 404。 -->
    <select id="findMediaById" resultMap="contentMediaMap">
        select id,content_id,url,type,sort from content_media where id=#{mediaId}
    </select>

    <!-- TV: updateFileExists —— `update content_media set file_exists=?, last_verify_time=? where id=?`
         （扫描/恢复后回写"文件存在"校验列；**不改 url**——与 updateMediaUrl 是两件事）。 -->
    <update id="updateFileExists">
        update content_media set file_exists=#{exists}, last_verify_time=#{lastVerifyTime}
        where id=#{mediaId}
    </update>

</mapper>
