<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  收藏记录 Mapper（表 favorite_item，V2 建）。

  T2 落"删夹一并删条目"这一条（R-02）；T4 补入收藏（insertItem）与移出
  （deleteByFolderAndContentIds，批量移出 + move 的源侧删除共用）；
  T5 补入状态（findFoldersByUserAndContent）与计数（单内容实时 COUNT；★ T12 读路径切列时
  已退役删除，oracle 口径由测试 SQL 承接，批量形态见下面 countDistinctUsersByContentIds）；
  T6 补入夹内分页（countByFolderId + findPageByFolderId）—— 本仓纪律是**不提前写无主 SQL**。
  ★ T6 残留提交（2026-10-09）：findPageByFolderId 由"跨域单条 LEFT JOIN"改为**只查本域三列**，
    标题/封面/作者与失效判定整体移交 content 装载契约（口径"看不了 ≈ 失效"，见 favorite.md 附录「编号速查」R-11）
    —— 跨域直连他域表的形态、封面规则副本与 URL 前缀第二份实现（I-07 ①②③）一并根治。

  ⚠️ 全局 `map-underscore-to-camel-case: false`；本文件的写语句（DELETE/INSERT）无列映射需求；
     读语句列名要么无下划线（id/name）、要么用显式别名（下面 findFoldersByUserAndContent
     没有下划线列；T12 的 countDistinctUsersByContentIds 用别名对齐 ContentFavoriteCount 属性名），
     故都不需要 resultMap。
-->
<mapper namespace="io.github.yjhhhaaa06.videoweb.favorite.dao.FavoriteItemDao">

    <!-- 删夹时清空该夹的收藏记录（R-02：删夹一并删条目）。
         ⚠️ 只按 folder_id 删（归属已由 service 先校验，单一判据，见 DAO Javadoc）；
         命中 idx_folder_time(folder_id, create_time) 的前导列。
         ⚠️ 不得改成"迁进默认夹"——那是一次数据搬迁，还要处理撞 uk_folder_content（R-02 已否决）。 -->
    <delete id="deleteByFolderId">
        DELETE FROM favorite_item WHERE folder_id = #{folderId}
    </delete>

    <!-- 收藏一条内容进一个夹（T4：/favorite/add 与 /favorite/move 共用）。
         ⚠️ 撞 uk_folder_content ⇒ DuplicateKeyException ⇒ 全局出口 409（重复收藏幂等拒绝），
           不写"先查后插"。user_id 是冗余列（归属已由 service 校验"夹是我的"）。
         ⚠️ 内容存在性由 service 先校验（ContentDao.isContentExist 带 is_deleted = 0），
           本 SQL 不碰 content 表 —— 「失效不可移入」由校验自然产生，别在这里写分支。 -->
    <insert id="insertItem">
        INSERT INTO favorite_item (folder_id, user_id, content_id)
        VALUES (#{folderId}, #{userId}, #{contentId})
    </insert>

    <!-- 从一个夹移出若干条（T4：批量移出 + move 的源侧删除；move 传单元素列表）。
         ★ 单条 DELETE ... IN 原生原子 ⇒ 批量移出不需要 @Transactional（事务边界篇 §一）。
         ★ 刻意**不带**任何 content 联结/存在性条件（G11 红线）：失效条目必须删得掉。
           幂等：命中的行少给（甚至 0 行）不算错，调用方不据此判失败。
         ⚠️ 空列表会在 MySQL 里生成 IN () 语法错 —— service 已拦空集为 400，别放开。 -->
    <delete id="deleteByFolderAndContentIds">
        DELETE FROM favorite_item
        WHERE folder_id = #{folderId}
          AND content_id IN
        <foreach collection="contentIds" item="contentId" open="(" separator="," close=")">
            #{contentId}
        </foreach>
    </delete>

    <!-- 某内容收在我的哪些夹（T5：GET /favorite/status 的 folders）。
         ★ 判据 (user_id, content_id) —— 同一内容可进多夹，不能按夹判；正好命中 idx_user_content
           (user_id, content_id) 的两列等值（**走索引**）。
           ⚠️ 别据此推断"计数那条用不上索引" —— 那条同样借这个索引（loose index scan，见下）。
         ★ JOIN（非 LEFT）：item 与 folder 同属本域，删夹时条目同事务一并删（R-02）⇒ 正常路径无孤儿，
           INNER JOIN 不丢行。⚠️ 但本表**无外键**、DB 不兜底 —— 该前提只由 FavoriteService.deleteFolder
           的 @Transactional 一处承担（favorite.md 附录「编号速查」I-04：零判别力、可被静默误删）。前提失效时
           症状是**跨端点不一致**：孤儿行 JOIN 不上 ⇒ status 报"未收藏"，而 count 那条不 JOIN ⇒ 仍计入。
           ⚠️ 本 SQL 不碰 content 表；T6 夹内列表**现在也不碰**（失效判定已整体走 content
           装载契约折叠，见 favorite.md 附录「编号速查」R-11）—— 两条都不要回流成跨域 JOIN（I-07 ③）。
         ★ 不判内容有效性：失效内容（含已删下架与"装不出来"的，R-11）的记录照样在
           （R-03 不自动清理）⇒ 照常返回它在的夹。
         ⚠️ 顺序（默认夹置顶 + 创建序）与 FavoriteFolderMapper.findByUserIdWithItemCount 同一契约。 -->
    <select id="findFoldersByUserAndContent"
            resultType="io.github.yjhhhaaa06.videoweb.favorite.model.vo.FavoriteFolderBriefVO">
        SELECT f.id AS id, f.name AS name
        FROM favorite_item i
        JOIN favorite_folder f ON f.id = i.folder_id
        WHERE i.user_id = #{userId} AND i.content_id = #{contentId}
        ORDER BY f.is_default DESC, f.id ASC
    </select>

    <!-- ==================================================================
         T6：夹内分页（GET /favorite/list）
         ================================================================== -->

    <!-- 夹内列表行映射（FavoriteItemVO 的**本域三列**）。
         ★ 本 SQL 只出 id / content_id / create_time（⇒ favoriteTime）；其余四列
           （invalid / title / coverUrl / authorName）由 Java 侧经 content 装载契约组装
           （FavoriteService.listFolderItems）——"内容可不可用"归 content 域、
           "失效长什么样"归本域，两层分开 ⇒ 反向验证两个注入点各自独立。
         ⚠️ 别在这里加 content 联结 / 封面 / 作者子查询（T6 残留提交已删过一次，
            理由见下面 findPageByFolderId 的注释与 favorite.md 附录「编号速查」R-11）。 -->
    <resultMap id="favoriteItemVoMap" type="io.github.yjhhhaaa06.videoweb.favorite.model.vo.FavoriteItemVO">
        <id property="id" column="id"/>
        <result property="contentId" column="content_id"/>
        <result property="favoriteTime" column="favorite_time"/>
    </resultMap>

    <!-- 夹内记录总数（total）—— ★ 数的是收藏**记录行**，含失效条目（R-07）。
         ⚠️ 本 SQL **刻意不碰 content 表**：一带 content 联结就必然要回答"失效算不算"，
            而答案是"算" ⇒ 联结只会把数变少（INNER JOIN 丢行 / LEFT JOIN + is_deleted=0 把"算"写成"不算"）。
            "失效也计入"不是写出来的分支，是**数对了对象**的自然结果
            —— 与 FavoriteFolderVO.itemCount（夹列表的每夹条目数）同一口径，两处必须相等。 -->
    <select id="countByFolderId" resultType="int">
        SELECT COUNT(*) FROM favorite_item WHERE folder_id = #{folderId}
    </select>

    <!-- 夹内一页（收藏时间倒序）。★ 只查**本域三列**；title / coverUrl / authorName / invalid
         由 FavoriteService.listFolderItems 经 ContentService.loadContentVOs 组装
         （T6 残留提交 2026-10-09；口径"看不了 ≈ 失效"，favorite.md 附录「编号速查」R-11）。
         ① 判失效**不在这里**：内容不存在 / 已删下架 / 媒体损坏 / 未知类型 ⇒ content 装载契约
            返回"取不到" ⇒ 本行渲染为占位。⚠️ 别回流成"JOIN content + is_deleted 判定" ——
            那只覆盖"无行 / 已删"两种，**测不出**"视频行缺失 / 未知 type"，会与新口径分叉。
         ② 分页单位是 favorite_item 行（G12）：LIMIT/OFFSET 作用在收藏记录上，
            一整页都是失效条目也照常返回整页（不补位、不跳过；跳过 ⇒ 用户看不到 ⇒ 永远清不掉）。
            ⚠️ 因此**不要**复用 ProfileService 的"跳过 null、total 不变"口径（ProfileService.java:109）。
         ③ 顺序 `create_time DESC, id DESC` —— create_time 是 datetime（**秒**精度），
            同秒收藏多条时只按 create_time 排会让页间顺序不确定（同一行可能出现在两页、
            或某页漏掉一行）；补 id DESC 作稳定 tie-breaker（id 递增 ⇒ 同秒内新的在前）。
         ④ 封面选取与 URL 前缀**不再由本 SQL / 本域负责**：封面规则收归 content 域一处
            （旧副本见 I-07 ①，URL 前缀第二份实现见 I-07 ②，均已删）。
         ⚠️ 已知边缘态（R-11 已拍板接受）：数据损坏（如视频行缺失）时本列表占位，
            而 add/move（isContentExist 带 is_deleted = 0）仍收得进 —— 该态无 API 可达
            （发布必插视频行、删只允许 type=2 图片、换源只改 url），属已登记取舍。 -->
    <select id="findPageByFolderId" resultMap="favoriteItemVoMap">
        SELECT i.id AS id,
               i.content_id AS content_id,
               i.create_time AS favorite_time
        FROM favorite_item i
        WHERE i.folder_id = #{folderId}
        ORDER BY i.create_time DESC, i.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- ==================================================================
         T9：判存在（互动域组装互动态用 —— 不 JOIN 的轻量版）
         ================================================================== -->

    <!-- 我是否收藏过某内容（T9）。★ 与 findFoldersByUserAndContent 的区别：**不 JOIN**
         favorite_folder —— "是否收藏过"只需判 (user_id, content_id) 的记录存在，不需要夹名；
         两列等值 ⇒ 命中 idx_user_content(user_id, content_id) 的点查（轻量判存在）。
         ⚠️ 判据是记录本身（不判内容有效性，R-03/R-07）；孤儿行边缘态下与 count 同侧仍算
            "已收藏"，与 JOIN 版（status）的分叉见 DAO Javadoc —— 孤儿行前提由 deleteFolder 的
            @Transactional 承担（其判别力已由 favorite.md 附录「编号速查」I-04 在 T8 收口）。
         ⚠️ 别回流成 "JOIN + 取夹名"（那是 /favorite/status 的形态）——本查询服务的是互动域的
            "我收藏过没有"，不是"收在哪些夹"。 -->
    <select id="existsByUserAndContent" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM favorite_item
            WHERE user_id = #{userId} AND content_id = #{contentId}
        )
    </select>

    <!-- 我在这批内容里已收藏的 content_id 子集（T9：互动域批量契约的一趟查询）。
         ★ 与 like 域的 findLikedContentIds 同形（命中子集，缺失由调用方补 false）。
         user_id 等值 + content_id IN ⇒ 命中 idx_user_content；
         DISTINCT：同一人把同一内容收进多个夹也只回一次（口径"按人去重"）。
         ⚠️ 不 JOIN favorite_folder（理由同上）；空列表会生成 IN () 语法错 —— service 已拦空集。 -->
    <select id="findFavoritedContentIds" resultType="long">
        SELECT DISTINCT content_id
        FROM favorite_item
        WHERE user_id = #{userId}
          AND content_id IN
        <foreach collection="contentIds" item="contentId" open="(" separator="," close=")">
            #{contentId}
        </foreach>
    </select>

    <!-- ==================================================================
         T11（二期-2）：收藏缓存要用到的两条读
         ================================================================== -->

    <!-- 该用户收藏过的**全部** content_id（T11：成员集 miss 回填，装载量 = 该用户收藏数）。
         ★ 与上面 findFavoritedContentIds 的分工：那条是"给定子集里的命中"（**降级**路径用，
           避免为 3 个 id 拉全量）；本条是"**全量**"（**回填**路径用）—— 成员 key 断言的是
           "这个人的收藏全集"，必须一次装全，否则缓存里是残缺集合（把已收藏判成未收藏）。
         ★ DISTINCT：同一内容收进多个夹只回一次（成员集表达"我收藏过"，与夹数无关）。
         ⚠️ 不 JOIN favorite_folder（与 existsByUserAndContent 同款理由：两个不同的问题）；
           不判内容有效性（失效内容的记录照样在，R-03/R-07 ⇒ 照样算"我还收着它"）。
         ⚠️ 本查询**无分页/上限**：用户维度反转的目的就是让装载量与内容热度解耦（同 like 的
           findLikedContentIdsByUser）。要窗口装载就得引入 partial: 前缀态与四处特判，**现在不做**。 -->
    <select id="findAllFavoritedContentIds" resultType="long">
        SELECT DISTINCT content_id
        FROM favorite_item
        WHERE user_id = #{userId}
    </select>

    <!-- 一个夹内的全部 content_id（T11：删夹前取失效集 —— 收藏数是**内容维度**的，
         ★ 记录删掉后就再查不出"刚动了哪些内容"，故必须**删之前**取）。
         ★ 只用于失效（DEL content:favoriteCount:{id}），不参与任何判定：收藏域写路径一律
           "整体失效"，不做增量（夹内唯一 ⇒ add/remove 不必然 ±1，见 {@code favorite.md 附录「编号速查」} I-11）。
         ⚠️ 必须与两条 DELETE **同事务**（FavoriteService.deleteFolder 的 @Transactional）：
           否则并发收藏让"取到的 id 集"与"实际删掉的行"不一致 ⇒ 失效集漏项。
         ⚠️ 不写 SELECT ... FOR UPDATE（本仓排除：判不存在时 RC 无效 / RR gap lock 共享 ⇒ 死锁）；
           命中 idx_folder_time(folder_id, create_time) 的前导列。 -->
    <select id="findContentIdsByFolderId" resultType="long">
        SELECT content_id
        FROM favorite_item
        WHERE folder_id = #{folderId}
    </select>

    <!-- ==================================================================
         T12（二期-3）：收藏数冗余列的批量重算 —— recountFavoriteCounts 第 1 步
         ================================================================== -->

    <!-- 一批内容的按人去重收藏数（一趟 GROUP BY，不是 N 次点查；口径 R-06 按人去重）。
         ★ 必须运行在调用方事务里（与 favorite_item 的本次增删同事务）—— 聚合看到的是
           本事务改完之后的状态（自己的写对自家事务可见）。
         ★ 聚合不出的 id（收藏清空 / 从未有人收藏 / 幽灵 id）**不在结果里** —— 调用方
           （FavoriteService.recountFavoriteCounts）按 0 补全后再走第 2 步批量 UPDATE，
           "清零"同样要落列（不变量对 0 成立）。
         ★ 别名 contentId / favoriteCount 对齐 ContentFavoriteCount 的属性名
           （全局 map-underscore-to-camel-case = false ⇒ 靠别名自动映射，不需要 resultMap）。
         ⚠️ 只碰本域表；content 列的写回在 ContentDao.updateFavoriteCounts（他域 DAO 薄依赖）。
         ⚠️ 空列表会生成 IN () 语法错 —— service 已拦空集（删空夹是合法路径）。
         ⚠️ 一期基线（单内容版 loose index scan ≈17ms / 2 万行，favorite.md §四）是本查询的对照面，
           T12 实测数字回写同处。 -->
    <select id="countDistinctUsersByContentIds"
            resultType="io.github.yjhhhaaa06.videoweb.content.model.ContentFavoriteCount">
        SELECT content_id AS contentId,
               COUNT(DISTINCT user_id) AS favoriteCount
        FROM favorite_item
        WHERE content_id IN
        <foreach collection="contentIds" item="contentId" open="(" separator="," close=")">
            #{contentId}
        </foreach>
        GROUP BY content_id
    </select>

</mapper>
