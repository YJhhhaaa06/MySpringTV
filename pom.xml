<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.YJhhhaaa06</groupId>
    <artifactId>video-web</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>MySpringTV</name>
    <description>MySpringTV</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- ==================== 可观测（第三批 T2 / 账 B3） ====================
             TV 自研 CacheStats 打点（六类事件计数 + 摘要日志）随缓存框架一起被裁掉，
             《迁移参照系》§三的原计划是"收敛为 Actuator"，但从未发生 ⇒ 登记为 B3。
             这里补上 Actuator（内含 micrometer-core）：
               * /actuator/metrics 暴露指标（CacheMetrics 记 cache.events{event=…}）；
               * /actuator/health 顺带获得（Testcontainers 的依赖就绪探测也能用）。
             版本由 Boot 父 POM 托管，勿手写。只引 starter，不引额外 registry
             （Prometheus 等抓取端点属部署形态，见决策⑨留后项）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 韧性：Redis 熔断（第三批 T3 / 账 B4） ====================
             TV 自研 cache/RedisCircuitBreaker（CLOSED→OPEN→HALF_OPEN 状态机）随 cache 包一起被裁，
             《迁移参照系》§三 的处置依据是"Resilience4j 接管"——但**从未接管** ⇒ 登记为 B4。
             本依赖只引**核心库**（不引 resilience4j-spring-boot3）：
               * 核心库是纯 Java、无 Spring 版本耦合，避免 starter 对 Boot 4.x 的适配风险；
               * 熔断器以 @Bean 手工装配（见 RedisBreakerConfig），接在协议层 RedisOps.guarded 外层。
             版本需显式声明（Boot 父 POM 不托管 resilience4j）。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- 声明式参数校验：承接 TV 散落各 Controller 的手写校验（踩坑清单 §8【隐患】） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JWT（决策③「保留 jwt」）：沿用 TV 的 auth0 java-jwt，JwtUtil 可近乎原样承接。
             Boot 不托管此件，需显式版本。 -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.6.1</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== 数据访问层（决策②） ====================
             MyBatis 原生；starter 传递引入 spring-boot-starter-jdbc，
             即 HikariCP 连接池 + spring-jdbc（@Transactional 的数据源事务管理）。
             mybatis-spring-boot 4.1.0 的父 POM 定向 spring-boot.version=4.1.0，
             与本项目 4.1.1 同代。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.1.0</version>
        </dependency>

        <!-- ==================== 缓存（决策⑤） ====================
             Jedis 控制变量：必须排除默认的 Lettuce，否则两个客户端同栈，
             正是决策⑤要消除的"排查盲区"。
             jedis 版本由 Boot 托管（4.1.1 -> 7.4.1），勿钉 TV 的 5.1.0。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <!-- ==================== 消息与异步（决策④） ====================
             amqp-client 版本由 Boot 托管（4.1.1 -> 5.30.0），
             勿沿用 TV 显式声明的 5.21.0（那属 E1「版本钉死 hack」）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 注意：本项目**暂未迁移到 Spring Security**（决策③后置）。
             切片 0 的鉴权由自研 JwtAuthFilter 承担（沿用 TV 的 AuthFilter 口径）。
             此件及上方 spring-boot-starter-security 均为后续切片预置。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== 测试：环境即代码（决策⑦ / T1+E2 债） ====================
             目标：测试自带依赖，不再依赖"本机恰好跑着的 docker 容器"。

             ⚠️ Testcontainers 2.0 是破坏性重构，模块坐标全部改名（按 1.x 坐标写会直接解析失败）：
                1.x  org.testcontainers:mysql           改名为 org.testcontainers:testcontainers-mysql
                1.x  org.testcontainers:rabbitmq        改名为 org.testcontainers:testcontainers-rabbitmq
                1.x  org.testcontainers:junit-jupiter   改名为 org.testcontainers:testcontainers-junit-jupiter
             版本由 Boot 父 POM 托管（testcontainers-bom 2.0.5），勿手写。

             注意：官方 2.0 模块清单里没有 redis 模块，Redis 用 GenericContainer 即可
             （Boot 托管的 testcontainers-redis-module 指社区 com.redis 出品，非 org.testcontainers）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ❌ 原 spring-rabbit-test（含 RabbitListenerTestHarness）已删除（第四批 T7-2 / 账 B11 → D30）：
             它自 S9 起**声明而未启用**——MQ 断言实际走 RabbitTemplate + 轮询（FeedMqTests），
             RabbitListenerTestHarness 与 @RabbitListenerTest 全仓零引用。留着只是噪声。
             ⚠️ 若将来真要用 RabbitListenerTestHarness，加回本块即可（版本由 spring-amqp BOM 托管）。 -->

        <!-- ==================== 架构约束测试（S6-B3，决策：ArchUnit） ====================
             目的：把"模块边界"从文档约定变成**会失败的测试**。S6 实测到的三个跨模块环
             （content⇄comment⇄like）与 common→user 倒挂，此前没有任何机制能拦住。

             ⚠️ 只引**核心包**，不引 archunit-junit5 引擎：
             本项目跑 JUnit Platform 6（Boot 4 自带），而 archunit-junit5 的引擎是为
             JUnit Platform 1.x 写的，混用有版本风险。核心包是纯库，直接在普通 @Test 里
             调 ClassFileImporter + Rule.check 即可，功能完全够用、依赖面更小。

             ⚠️ 版本必须 ≥ 1.5.0：JDK 25 的 class 文件主版本号是 69，更早的 ArchUnit
             读取时会报 "Unsupported class file major version 69"。1.5.1 是当前最新。

             依赖冻结纪律（SOP §五）：这是 S6 的**独立一项**，不与业务切片混提交。
             若将来弃用，删本依赖 + ArchitectureTests 即可，业务代码零改动。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- T2：把日志目录钉到 target/ 内（`video.log.dir` ← 环境/系统属性 LOG_DIR），
                         于是测试运行产生的 system/error/access/audit 四个文件都落
                         target/test-logs/，`mvn clean` 即回收，不往仓库根的 logs/ 写。

                         为什么走 surefire 而不是测试类的 static 块：日志系统由 Boot 在
                         **上下文启动时**初始化并读这把键，而"哪个测试类先被加载"不确定；
                         surefire 的系统属性在 fork 出 JVM 时就位，无竞态。 -->
                    <systemPropertyVariables>
                        <LOG_DIR>${project.build.directory}/test-logs</LOG_DIR>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
