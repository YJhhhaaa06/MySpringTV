<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.YJhhhaaa06</groupId>
    <artifactId>video-web</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>MySpringTV</name>
    <description>MySpringTV</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 声明式参数校验：承接 TV 散落各 Controller 的手写校验（踩坑清单 §8【隐患】） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JWT（决策③「保留 jwt」）：沿用 TV 的 auth0 java-jwt，JwtUtil 可近乎原样承接。
             Boot 不托管此件，需显式版本。 -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.6.1</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== 数据访问层（决策②） ====================
             MyBatis 原生；starter 传递引入 spring-boot-starter-jdbc，
             即 HikariCP 连接池 + spring-jdbc（@Transactional 的数据源事务管理）。
             mybatis-spring-boot 4.1.0 的父 POM 定向 spring-boot.version=4.1.0，
             与本项目 4.1.1 同代。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.1.0</version>
        </dependency>

        <!-- ==================== 缓存（决策⑤） ====================
             Jedis 控制变量：必须排除默认的 Lettuce，否则两个客户端同栈，
             正是决策⑤要消除的"排查盲区"。
             jedis 版本由 Boot 托管（4.1.1 -> 7.4.1），勿钉 TV 的 5.1.0。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <!-- ==================== 消息与异步（决策④） ====================
             amqp-client 版本由 Boot 托管（4.1.1 -> 5.30.0），
             勿沿用 TV 显式声明的 5.21.0（那属 E1「版本钉死 hack」）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 注意：本项目**暂未迁移到 Spring Security**（决策③后置）。
             切片 0 的鉴权由自研 JwtAuthFilter 承担（沿用 TV 的 AuthFilter 口径）。
             此件及上方 spring-boot-starter-security 均为后续切片预置。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== 测试：环境即代码（决策⑦ / T1+E2 债） ====================
             目标：测试自带依赖，不再依赖"本机恰好跑着的 docker 容器"。

             ⚠️ Testcontainers 2.0 是破坏性重构，模块坐标全部改名（按 1.x 坐标写会直接解析失败）：
                1.x  org.testcontainers:mysql           改名为 org.testcontainers:testcontainers-mysql
                1.x  org.testcontainers:rabbitmq        改名为 org.testcontainers:testcontainers-rabbitmq
                1.x  org.testcontainers:junit-jupiter   改名为 org.testcontainers:testcontainers-junit-jupiter
             版本由 Boot 父 POM 托管（testcontainers-bom 2.0.5），勿手写。

             注意：官方 2.0 模块清单里没有 redis 模块，Redis 用 GenericContainer 即可
             （Boot 托管的 testcontainers-redis-module 指社区 com.redis 出品，非 org.testcontainers）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MQ 断言工具（@RabbitListenerTest / RabbitListenerTestHarness），版本由 spring-amqp BOM 托管 -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== 架构约束测试（S6-B3，决策：ArchUnit） ====================
             目的：把"模块边界"从文档约定变成**会失败的测试**。S6 实测到的三个跨模块环
             （content⇄comment⇄like）与 common→user 倒挂，此前没有任何机制能拦住。

             ⚠️ 只引**核心包**，不引 archunit-junit5 引擎：
             本项目跑 JUnit Platform 6（Boot 4 自带），而 archunit-junit5 的引擎是为
             JUnit Platform 1.x 写的，混用有版本风险。核心包是纯库，直接在普通 @Test 里
             调 ClassFileImporter + Rule.check 即可，功能完全够用、依赖面更小。

             ⚠️ 版本必须 ≥ 1.5.0：JDK 25 的 class 文件主版本号是 69，更早的 ArchUnit
             读取时会报 "Unsupported class file major version 69"。1.5.1 是当前最新。

             依赖冻结纪律（SOP §五）：这是 S6 的**独立一项**，不与业务切片混提交。
             若将来弃用，删本依赖 + ArchitectureTests 即可，业务代码零改动。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
